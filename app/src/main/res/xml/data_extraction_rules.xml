<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 and later (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Saved sound clips can hold voices from the house: they stay on this device. -->
    <cloud-backup>
        <exclude domain="file" path="samples/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="samples/" />
    </device-transfer>
</data-extraction-rules>
